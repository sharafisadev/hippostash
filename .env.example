# ─────────────────────────────────────────────────────────────
# Hippo Stash — environment variables. Copy to .env.local and fill in.
# ─────────────────────────────────────────────────────────────

NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key
# Server-only (storage provisioning, /api/files, /api/convert). NEVER expose to the client.
SUPABASE_SECRET_KEY=sb_secret_xxx

# Conversion engine for documents (optional — images convert in-browser).
# https://cloudconvert.com → Dashboard → API Keys
CLOUDCONVERT_API_KEY=
